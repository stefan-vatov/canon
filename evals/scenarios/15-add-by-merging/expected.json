{
  "test_cmd": "uv run python -m unittest discover -s . -p 'test_*.py'",
  "allowed_change_globs": [
    "ledger.py",
    "test_*.py",
    "canon/*"
  ],
  "rules": [
    {
      "id": "journal_append_only_kept",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "must_regex": "(?i)append-only",
      "description": "the ledger's append-only journal guarantee survives"
    },
    {
      "id": "invoice_numbering_kept",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "must_regex": "(?i)gapless",
      "description": "gapless invoice numbering survives"
    },
    {
      "id": "logout_revocation_kept",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "must_regex": "(?i)revok",
      "description": "server-side logout revocation survives"
    },
    {
      "id": "sync_ordering_kept",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "must_regex": "(?i)stale",
      "description": "the offline-sync staleness rule survives"
    },
    {
      "id": "cents_rule_with_reason",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "must_regex": "(?is)(integer|whole)[^.\\n]{0,80}cents.{0,400}round|round.{0,400}(integer|whole)[^.\\n]{0,80}cents",
      "description": "the integer-cents rule and its rounding reason appear together"
    },
    {
      "id": "no_contrary_rule",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "forbid_regex": "(?i)\\bdollars\\b|always round",
      "description": "no note states a rule contrary to the owner's"
    },
    {
      "id": "canon_did_not_grow",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "max_matching_files": 5,
      "description": "at the owner's budget a note is added only by merging or removing one"
    },
    {
      "id": "no_decision_records",
      "glob": "*decision*",
      "exclude_globs": [
        "*.py"
      ],
      "max_matching_files": 0,
      "description": "no decision record, log, register or ADR anywhere"
    },
    {
      "id": "no_adr_records",
      "glob": "*adr*",
      "exclude_globs": [
        "*.py"
      ],
      "max_matching_files": 0,
      "description": "no ADR directory or ADR files anywhere"
    },
    {
      "id": "no_metadata",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "forbid_regex": "(?m)\\A---\\s*$|^(?:status|sources|verified|supersedes|scope|validation):",
      "description": "no front matter, status fields or stamps"
    }
  ],
  "holdout": {
    "dir": "holdout",
    "test_cmd": "uv run python -m unittest holdout_t15"
  }
}
