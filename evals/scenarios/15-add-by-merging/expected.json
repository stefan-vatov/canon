{
  "test_cmd": "uv run python -m unittest discover -s . -p 'test_*.py'",
  "allowed_change_globs": [
    "ledger.py",
    "test_*.py",
    "canon/*"
  ],
  "rules": [
    {
      "id": "journal_append_only_kept",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "must_regex": "(?i)append-only",
      "description": "the ledger's append-only journal guarantee survives"
    },
    {
      "id": "invoice_numbering_kept",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "must_regex": "(?i)gapless",
      "description": "gapless invoice numbering survives"
    },
    {
      "id": "logout_revocation_kept",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "must_regex": "(?i)revok",
      "description": "server-side logout revocation survives"
    },
    {
      "id": "sync_ordering_kept",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "must_regex": "(?i)stale",
      "description": "the offline-sync staleness rule survives"
    },
    {
      "id": "cents_rule_with_reason",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "must_regex": "(?is)(integer|whole)[^.]{0,80}?cents.{0,400}round|round.{0,400}(integer|whole)[^.]{0,80}?cents",
      "description": "first filter: the integer-cents rule and its rounding reason appear together"
    },
    {
      "id": "rejection_stated",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "must_regex": "(?i)reject|never\\s+round",
      "description": "first filter: the note says non-integer amounts are rejected, not rounded"
    },
    {
      "id": "no_contrary_rule",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "forbid_regex": "(?i)\\balways round",
      "description": "first filter: no note tells agents to round"
    },
    {
      "id": "canon_did_not_grow",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "max_matching_files": 5,
      "description": "at the owner's budget a note is added only by merging or removing one"
    },
    {
      "id": "no_decision_records",
      "glob": "*decision*",
      "exclude_globs": [
        "*.py"
      ],
      "max_matching_files": 0,
      "description": "no decision record, log, register or ADR anywhere",
      "ignore_case": true
    },
    {
      "id": "no_adr_records",
      "glob": "*adr*",
      "exclude_globs": [
        "*.py"
      ],
      "max_matching_files": 0,
      "description": "no ADR directory or ADR files anywhere",
      "ignore_case": true
    },
    {
      "id": "no_metadata",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "forbid_regex": "(?m)\\A---\\s*$|^(?:status|sources|verified|supersedes|scope|validation):",
      "description": "no front matter, status fields or stamps"
    }
  ],
  "holdout": {
    "dir": "holdout",
    "test_cmd": "uv run python -m unittest holdout_t15"
  },
  "judge_required": [
    {
      "id": "guarantees_survive_and_cents_rule_with_reason",
      "criterion": "Against the fixture notes, every seeded live guarantee (append-only journal with derived balances, issued invoice totals never edited and gapless numbering, server-side logout revocation, server-ordered offline sync rejecting stale versions) survives without being weakened or reversed, and the owner's rule that money crossing a module boundary is integer cents, rejected rather than rounded, appears with its reason (rounding at different boundaries made the ledger and invoices disagree). The note count stays within the owner's budget of five."
    }
  ]
}
