{
  "test_cmd": "uv run python -m unittest discover -s . -p 'test_*.py'",
  "required_files": [
    "canon/sessions.md"
  ],
  "allowed_change_globs": [
    "sessions.py",
    "test_*.py",
    "canon/sessions.md"
  ],
  "rules": [
    {
      "id": "timeout_configurable",
      "glob": "sessions.py",
      "must_regex": "def is_expired\\([^)]*timeout_minutes",
      "description": "the requested parameter exists"
    },
    {
      "id": "falsified_sentence_gone",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "forbid_regex": "(?i)(?<!every )\\b(30|thirty)[ -]?min|half[- ]an?[- ]hour|half-hour|\\b1,?800\\s*s(ec|econds)?\\b",
      "description": "first filter: no fixed half-hour expiry in common forms (the sweeper's 'every 30 minutes' is the one true 30-minute fact); the judge grades meaning"
    },
    {
      "id": "cross_owner_fact_kept",
      "glob": "canon/sessions.md",
      "must_regex": "(?i)sweeper",
      "description": "the note still says an outside sweeper depends on expiry"
    },
    {
      "id": "limits_not_transcribed",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "forbid_regex": "\\b240\\b",
      "description": "the new range lives in code and tests; Canon does not copy it"
    },
    {
      "id": "no_history_in_canon",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "forbid_regex": "(?i)\\bpreviously\\b|\\bformerly\\b|\\bsupersed|\\bused to be\\b|\\b20\\d\\d-\\d\\d-\\d\\d\\b",
      "description": "Canon states current fact; git is the history"
    },
    {
      "id": "canon_did_not_grow",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "max_matching_files": 1,
      "description": "no new Canon note"
    },
    {
      "id": "no_decision_records",
      "glob": "*decision*",
      "exclude_globs": [
        "*.py"
      ],
      "max_matching_files": 0,
      "description": "no decision record, log, register or ADR anywhere",
      "ignore_case": true
    },
    {
      "id": "no_adr_records",
      "glob": "*adr*",
      "exclude_globs": [
        "*.py"
      ],
      "max_matching_files": 0,
      "description": "no ADR directory or ADR files anywhere",
      "ignore_case": true
    },
    {
      "id": "no_metadata",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "forbid_regex": "(?m)\\A---\\s*$|^(?:status|sources|verified|supersedes|scope|validation):",
      "description": "no front matter, status fields or stamps"
    }
  ],
  "holdout": {
    "dir": "holdout",
    "test_cmd": "uv run python -m unittest holdout_t12"
  },
  "judge_required": [
    {
      "id": "no_fixed_expiry_stated",
      "criterion": "Against the fixture note (canon/sessions.md), the final note no longer states any fixed session expiry duration in any wording, still says the outside seat sweeper depends on session expiry, and copies no limit from the code."
    }
  ]
}
