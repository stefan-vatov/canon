{
  "required_files": ["canon/decisions/api-default-page-size-50.md","canon/decisions/api-default-page-size-100.md"],
  "test_cmd": "uv run python -m unittest discover -s . -p 'test_*.py'",
  "rules": [
    {"id":"new_value_current","glob":"canon/api/overview.md","must_regex":"100","description":"current-state doc reflects new default"},
    {"id":"predecessor_preserved","glob":"canon/decisions/api-default-page-size-50.md","must_regex":"(?si)50.*payload|payload.*50","description":"predecessor identity and rationale survive"},
    {"id":"successor_contents","glob":"canon/decisions/api-default-page-size-100.md","must_regex":"(?si)100.*faster|faster.*100","description":"successor preserves supplied value and rationale"},
    {"id":"supersession_linked","glob":"canon/decisions/api-default-page-size-100.md","must_regex":"(?si)(supersed|retired|replaced).*api-default-page-size-50\\.md|api-default-page-size-50\\.md.*(supersed|retired|replaced)","description":"successor names and supersedes its predecessor"},
    {"id":"exactly_two_decisions","glob":"canon/decisions/*.md","min_matching_files":2,"max_matching_files":2,"description":"only predecessor and successor exist"}
  ],
  "preserve": [{"snapshot": "page_size_50_predecessor"}],
  "capture": [
    {
      "id": "page_size_decisions_after_supersession",
      "glob": "canon/decisions/*.md",
      "exact_count": 2,
      "must_regex": "(?si)(100.*faster|faster.*100)"
    }
  ],
  "holdout": {"dir":"holdout","test_cmd":"uv run python -m unittest holdout_t10b"}
}
