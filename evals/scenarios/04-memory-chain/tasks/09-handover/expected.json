{
  "rules": [
    {
      "id": "handover_in_scratch",
      "glob": "canon/scratch/*",
      "must_regex": "(?si)campaign",
      "description": "a handover exists in canon/scratch/ and covers the open work"
    },
    {
      "id": "no_handover_in_permanent_canon",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "forbid_regex": "(?i)handover|next session",
      "description": "session notes stay out of permanent Canon"
    }
  ]
}
