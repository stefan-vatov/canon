{
  "test_cmd": "uv run python -m unittest discover -s . -p 'test_*.py'",
  "rules": [
    {
      "id": "apply_promo_implemented",
      "glob": "orders.py",
      "must_regex": "def apply_promo\\([^)]*int",
      "description": "function exists with type hints"
    },
    {
      "id": "terminology_kept_durably",
      "glob": "*",
      "exclude_globs": [
        "test_*.py"
      ],
      "must_regex": "(?si)campaign.{0,300}expir|expir.{0,300}campaign",
      "search_commit_messages": true,
      "description": "the campaign definition (shared expiry) survives in a durable home: code, a note or a commit"
    },
    {
      "id": "canon_did_not_grow",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "max_matching_files": 1,
      "description": "the decision and the terms add no Canon note"
    },
    {
      "id": "no_decision_records",
      "glob": "*decision*",
      "exclude_globs": [
        "*.py"
      ],
      "max_matching_files": 0,
      "description": "no decision record, log, register or ADR anywhere"
    },
    {
      "id": "no_metadata",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "forbid_regex": "(?m)\\A---\\s*$|^(?:status|sources|verified|supersedes|scope|validation):",
      "description": "no front matter, status fields or stamps"
    }
  ],
  "holdout": {
    "dir": "holdout",
    "test_cmd": "uv run python -m unittest holdout_t01"
  }
}
