{
  "test_cmd": "uv run python -m unittest discover -s . -p 'test_*.py'",
  "rules": [
    {
      "id": "validate_promo_implemented",
      "glob": "orders.py",
      "must_regex": "def validate_promo\\(",
      "description": "helper exists"
    }
  ],
  "preserve": [
    {"snapshot": "promo_40_predecessor"},
    {"snapshot": "promo_decisions_after_supersession", "exact_set": true}
  ],
  "holdout": {
    "dir": "holdout",
    "test_cmd": "uv run python -m unittest holdout_t06"
  }
}
