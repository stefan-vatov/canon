{
  "test_cmd": "uv run python -m unittest discover -s . -p 'test_*.py'",
  "required_files": [
    "canon/stock.md"
  ],
  "allowed_change_globs": [
    "inventory.py",
    "test_*.py"
  ],
  "diff_scope_required": true,
  "rules": [
    {
      "id": "restock_implemented",
      "glob": "inventory.py",
      "must_regex": "def restock\\(",
      "description": "requested function exists"
    },
    {
      "id": "restock_tested",
      "glob": "test_*.py",
      "must_regex": "restock",
      "description": "a test exercises it"
    },
    {
      "id": "no_process_rules_recorded",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "forbid_regex": "(?i)executor|orchestrator|three bullet|slices? of one function|whole test suite",
      "description": "session and process directions from an agent-written brief are not written into Canon"
    },
    {
      "id": "canon_did_not_grow",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "max_matching_files": 1,
      "description": "no new Canon note"
    },
    {
      "id": "no_decision_records",
      "glob": "*decision*",
      "exclude_globs": [
        "*.py"
      ],
      "max_matching_files": 0,
      "description": "'we decided' in an agent's brief creates no record"
    }
  ],
  "holdout": {
    "dir": "holdout",
    "test_cmd": "uv run python -m unittest holdout_t14"
  }
}
