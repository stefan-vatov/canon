{
  "test_cmd": "uv run python -m unittest discover -s . -p 'test_*.py'",
  "allowed_change_globs": [
    "wordstats.py",
    "test_*.py",
    ".gitignore",
    "canon/.gitkeep"
  ],
  "rules": [
    {
      "id": "top_words_implemented",
      "glob": "wordstats.py",
      "must_regex": "def top_words\\(",
      "description": "the requested function exists"
    },
    {
      "id": "top_words_tested",
      "glob": "test_*.py",
      "must_regex": "top_words",
      "description": "a test exercises the new function"
    },
    {
      "id": "scratch_gitignored",
      "glob": ".gitignore",
      "must_regex": "canon/scratch",
      "description": "canon/scratch/ is git-ignored"
    },
    {
      "id": "bootstrap_writes_no_notes",
      "glob": "canon/*",
      "exclude_globs": [
        "canon/.gitkeep",
        "canon/scratch/*"
      ],
      "max_matching_files": 0,
      "description": "an empty Canon is healthy: no manifest, standards, skeleton or invented notes"
    },
    {
      "id": "no_decision_records",
      "glob": "*decision*",
      "exclude_globs": [
        "*.py"
      ],
      "max_matching_files": 0,
      "description": "no decision record, log, register or ADR anywhere",
      "ignore_case": true
    },
    {
      "id": "no_adr_records",
      "glob": "*adr*",
      "exclude_globs": [
        "*.py"
      ],
      "max_matching_files": 0,
      "description": "no ADR directory or ADR files anywhere",
      "ignore_case": true
    }
  ]
}
