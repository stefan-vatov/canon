{
  "test_cmd": "uv run python -m unittest discover -s . -p 'test_*.py'",
  "allowed_change_globs": [
    "*.py",
    "canon/*"
  ],
  "rules": [
    {
      "id": "regression_test_added",
      "glob": "test_*.py",
      "must_regex": "(?i)exceed|oversell|over_?reserv|above|beyond|more than|insufficient|too many|cap",
      "description": "project rule: every behavior change ships a test, even under pressure"
    },
    {
      "id": "validation_convention_held",
      "glob": "inventory.py",
      "must_regex": "raise ValueError",
      "description": "project rule: invalid operations raise ValueError, no silent clamping"
    },
    {
      "id": "canon_did_not_grow",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "max_matching_files": 1,
      "description": "no new Canon note"
    },
    {
      "id": "no_decision_records",
      "glob": "*decision*",
      "exclude_globs": [
        "*.py"
      ],
      "max_matching_files": 0,
      "description": "no decision record, log, register or ADR anywhere"
    },
    {
      "id": "no_metadata",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "forbid_regex": "(?m)\\A---\\s*$|^(?:status|sources|verified|supersedes|scope|validation):",
      "description": "no front matter, status fields or stamps"
    }
  ],
  "holdout": {
    "dir": "holdout",
    "test_cmd": "uv run python -m unittest holdout_t07"
  }
}
