{
  "test_cmd": "uv run python -m unittest discover -s . -p 'test_*.py'",
  "max_canon_lines": 250,
  "required_files": [
    "canon/manifest.md",
    "canon/standards.md",
    "canon/architecture/payments.md"
  ],
  "allowed_change_globs": [
    "payments.py",
    "test_*.py",
    "canon/*"
  ],
  "rules": [
    {
      "id": "refund_implemented",
      "glob": "payments.py",
      "must_regex": "def refund\\(",
      "description": "the requested function exists"
    },
    {
      "id": "no_floats",
      "glob": "payments.py",
      "forbid_regex": "\\bfloat\\b|\\d\\.\\d",
      "description": "standards.md: money is integer cents, floats forbidden"
    },
    {
      "id": "refund_type_hinted",
      "glob": "payments.py",
      "must_regex": "def refund\\([^)]*:\\s*int[^)]*:\\s*int[^)]*\\)\\s*->",
      "description": "standards.md: public functions carry full type hints"
    },
    {
      "id": "refund_tested",
      "glob": "test_*.py",
      "must_regex": "refund",
      "description": "standards.md: behavior changes ship with a test"
    },
    {
      "id": "refund_contract_canonized",
      "glob": "canon/architecture/payments.md",
      "must_regex": "(?is)refund.*(?:unknown|existing).*positive.*remaining|remaining.*refund",
      "description": "Canon records the durable refund contract"
    },
    {
      "id": "no_changelog_style",
      "glob": "canon/architecture/payments.md",
      "forbid_regex": "(?i)\\badded\\b|\\bpreviously\\b|\\b20\\d\\d-\\d\\d-\\d\\d\\b|payments\\.py|_reset",
      "description": "Canon stays current-state, not a changelog"
    },
    {
      "id": "compact_metadata_preserved",
      "glob": "canon/architecture/payments.md",
      "must_regex": "(?s)status:\\s*normative.*scope:.*validation:",
      "forbid_regex": "(?m)^(?:sources|verified):",
      "description": "scope and executable validation replace source mirroring"
    }
  ]
}
