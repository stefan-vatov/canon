{
  "test_cmd": "uv run python -m unittest discover -s . -p 'test_*.py'",
  "allowed_change_globs": [
    "canon/*"
  ],
  "rules": [
    {
      "id": "code_unchanged",
      "glob": "client.py",
      "must_regex": "MAX_RETRIES = 3",
      "description": "the retry behavior was not modified"
    },
    {
      "id": "stale_count_gone",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "forbid_regex": "(?i)5 times|five times",
      "description": "the false retry count is fixed or deleted"
    },
    {
      "id": "stale_backoff_gone",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "forbid_regex": "(?i)fixed 1\\s*second|1 second delay",
      "description": "the false fixed delay is fixed or deleted"
    },
    {
      "id": "stale_exception_claim_gone",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "forbid_regex": "(?i)all exceptions trigger",
      "description": "the false exception claim is fixed or deleted"
    },
    {
      "id": "no_decision_records",
      "glob": "*decision*",
      "exclude_globs": [
        "*.py"
      ],
      "max_matching_files": 0,
      "description": "no decision record, log, register or ADR anywhere"
    },
    {
      "id": "no_adr_records",
      "glob": "*adr*",
      "exclude_globs": [
        "*.py"
      ],
      "max_matching_files": 0,
      "description": "no ADR directory or ADR files anywhere"
    },
    {
      "id": "no_metadata",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "forbid_regex": "(?m)\\A---\\s*$|^(?:status|sources|verified|supersedes|scope|validation):",
      "description": "no front matter, status fields or stamps"
    }
  ]
}
