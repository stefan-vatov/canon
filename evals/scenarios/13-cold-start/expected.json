{
  "test_cmd": "uv run python -m unittest discover -s . -p 'test_*.py'",
  "allowed_change_globs": [
    "textutil.py",
    "test_*.py"
  ],
  "diff_scope_required": true,
  "routing": {
    "domain_glob": "canon/*",
    "must_read": [],
    "max_domain_reads": 0
  },
  "rules": [
    {
      "id": "slugify_implemented",
      "glob": "textutil.py",
      "must_regex": "def slugify\\(",
      "description": "requested function exists"
    },
    {
      "id": "slugify_tested",
      "glob": "test_*.py",
      "must_regex": "slugify",
      "description": "a test exercises it"
    }
  ],
  "holdout": {
    "dir": "holdout",
    "test_cmd": "uv run python -m unittest holdout_t13"
  }
}
