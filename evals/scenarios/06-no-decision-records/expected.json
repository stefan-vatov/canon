{
  "test_cmd": "uv run python -m unittest discover -s . -p 'test_*.py'",
  "required_files": [
    "canon/support-tickets.md"
  ],
  "allowed_change_globs": [
    "*.py",
    "canon/support-tickets.md"
  ],
  "rules": [
    {
      "id": "canon_did_not_grow",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "max_matching_files": 1,
      "description": "two sessions later Canon holds the one note it started with"
    },
    {
      "id": "no_decision_records",
      "glob": "*decision*",
      "exclude_globs": [
        "*.py"
      ],
      "max_matching_files": 0,
      "description": "no decision record, log, register or ADR anywhere"
    },
    {
      "id": "no_history_in_canon",
      "glob": "canon/*.md",
      "exclude_globs": [
        "canon/scratch/*"
      ],
      "forbid_regex": "(?i)\\bpreviously\\b|\\bformerly\\b|\\bsupersed|\\bused to be\\b|\\b20\\d\\d-\\d\\d-\\d\\d\\b|\\bwe decided\\b",
      "description": "Canon states current fact; git is the history"
    }
  ],
  "preserve": [
    {
      "snapshot": "code_after_decision",
      "exact_set": true
    }
  ],
  "holdout": {
    "dir": "holdout",
    "test_cmd": "uv run python -m unittest holdout_t06f"
  }
}
