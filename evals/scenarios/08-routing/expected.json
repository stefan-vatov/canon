{
  "test_cmd": "uv run python -m unittest discover -s . -p 'test_*.py'",
  "max_canon_lines": 250,
  "required_files": [
    "canon/manifest.md", "canon/standards.md",
    "canon/architecture/pricing.md"
  ],
  "allowed_change_globs": ["billingcore.py", "test_*.py"],
  "routing": {
    "domain_glob": "canon/architecture/*.md",
    "must_read": ["canon/architecture/pricing.md"],
    "max_domain_reads": 2
  },
  "rules": [
    {
      "id": "fee_implemented",
      "glob": "billingcore.py",
      "must_regex": "def apply_platform_fee\\(",
      "description": "requested function exists"
    },
    {
      "id": "correct_rate_used",
      "glob": "billingcore.py",
      "must_regex": "250|\\b25\\b",
      "description": "the platform fee rate (250 bps) from the pricing domain is used"
    },
    {
      "id": "distractor_rates_absent",
      "glob": "billingcore.py",
      "forbid_regex": "\\b(1500|800|500)\\b",
      "description": "no distractor rate (late-fee 1500 / tax 800 / sampling 500 bps) leaked into pricing code"
    },
    {
      "id": "no_floats",
      "glob": "billingcore.py",
      "forbid_regex": "\\bfloat\\b|\\d\\.\\d",
      "description": "standards: integer cents/bps only"
    },
    {
      "id": "no_implementation_inventory",
      "glob": "canon/architecture/pricing.md",
      "must_regex": "(?i)250 basis points",
      "forbid_regex": "(?i)apply_platform_fee|billingcore\\.py|sources:|verified:",
      "description": "the established invariant needs no Canon edit for a new implementation"
    }
  ],
  "holdout": {"dir": "holdout", "test_cmd": "uv run python -m unittest holdout_t08"}
}
