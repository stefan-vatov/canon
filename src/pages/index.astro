---
import ArchMark from "../components/ArchMark.astro";
import CanonExhibit from "../components/CanonExhibit.astro";
import ChurnFigure from "../components/ChurnFigure.astro";
import CompanionPlate from "../components/CompanionPlate.astro";
import RecordSpecimen from "../components/RecordSpecimen.astro";
import RoutingPlate from "../components/RoutingPlate.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Project Canon — code remembers where. Canon remembers why";
const pageDescription =
  "A handful of notes holding what code, tests and git cannot tell your coding agents, kept small by one block of rules in AGENTS.md or CLAUDE.md: nothing read up front, no decision records, no stamps, no checker, and the owner's current word above every note.";

// what may earn a note. Everything else has a better home; the fifth
// entry is the one directory with no authority at all.
const anatomy = [
  {
    name: "Guarantees across owners",
    copy: "A rule two services, a client and a job all rely on, which no single module can hold. Stated as current fact, its reason in a clause, naming the test that enforces it.",
  },
  {
    name: "Accepted gaps",
    copy: "What the owner chose not to fix, and why, so the next session does not fix it uninvited or assume it is covered.",
  },
  {
    name: "Measured dead ends",
    copy: "What was tried, the number it produced, the commit. A cache that saved nothing in production is worth one line so nobody adds it again.",
  },
  {
    name: "Approved plans",
    copy: "Owner-approved constraints for work not built yet. Deleted once built, so intent never fossilizes into a spec that copies the code.",
  },
  {
    name: "Scratch",
    copy: "Git-ignored. Handovers, progress and session notes live here: never read at session start, never cited, never a rule.",
  },
];

const scenarios = [
  ["01-bootstrap", "create canon/, write no notes"],
  ["02-feature", "add a feature; copy nothing into canon"],
  ["03-drift", "a note contradicts correct code"],
  ["04-memory-chain", "ten fresh sessions, no records"],
  ["05-impact", "refactor — canon untouched"],
  ["06-no-decision-records", "a decision lands with no record"],
  ["07-pressure", "urgency waives no test"],
  ["08-routing", "read the one note that matches"],
  ["09-abstention", "absent policy — surface it, don't invent"],
  ["10-reversal", "edit in place; the old value goes"],
  ["11-owner-wins", "a note's \u201cnever\u201d yields to the owner"],
  ["12-falsified-sentence", "fix what the change made false"],
  ["13-cold-start", "code-only task, zero canon reads"],
  ["14-executor-brief", "an agent's \u201calways\u201d is not a rule"],
  ["15-add-by-merging", "at the budget, merge — don't add"],
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <SiteHeader />
  <main id="main">
    <section class="hero shell">
      <div class="hero-copy">
        <span class="mono-label">Project memory for coding agents, kept small</span>
        <h1>
          <span class="line">Code remembers where.</span>
          <span class="line">Canon remembers <em>why.</em></span>
        </h1>
        <p class="lede prose">
          Most of what an agent needs is already in the repository: behavior
          in the code, limits in the tests, the reason for a change in its
          commit. Project Canon is one block of rules for your
          <strong>AGENTS.md</strong> that sends each kind of knowledge to that
          home, and keeps the rest — the few guarantees no single module can
          hold — in a handful of notes nobody has to read up front.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#adopt">
            Install the block
            <span aria-hidden="true">→</span>
          </a>
          <a class="btn btn-ghost" href="/how-it-works">Why so little</a>
        </div>
        <p class="hero-facts">
          <span>One block, about 700 words</span>
          <span>Claude Code / Codex / Pi</span>
          <span>MIT</span>
          <span>No checker</span>
        </p>
      </div>

      <CanonExhibit />
    </section>

    <RecordSpecimen />

    <section id="churn" class="article shell" aria-label="The churn problem">
      <div class="article-rule"><span><b>§ I</b> — The churn</span></div>

      <div class="drift-grid">
        <div>
          <h2>Every session starts <em>amnesiac.</em></h2>

          <p class="statement">
            Every system is shaped by reasons — constraints survived,
            trade-offs chosen, failures remembered.
          </p>
          <p class="statement quiet">
            An agent reading the code sees only the shape. Most reasons are
            recoverable — from tests, comments, commit bodies — but a few
            span several owners and live nowhere, so each session guesses.
          </p>

          <blockquote class="pull-quote">
            <p>
              What code, tests and git cannot tell you.
            </p>
            <cite>— the shipped block, on what Canon holds</cite>
          </blockquote>
        </div>

        <ChurnFigure />
      </div>

      <div class="drift-kicker">
        <p class="prose">
          Documentation was supposed to fix this, and made it worse: docs
          written as inventories — file lists, helper catalogs, specs that
          restate the code — go stale the moment the code moves. Agents learn
          that the docs lie, and stop reading them. The fix is not more
          documentation. It is a record that owns only what no other home can.
        </p>
        <p class="sharp">
          A copy of the code is stale by the next commit. A guarantee is stale
          only when the owner changes their mind.
        </p>
      </div>
    </section>

    <section id="lesson" class="article shell" aria-label="What the field showed">
      <div class="article-rule"><span><b>§ II</b> — The lesson</span></div>

      <h2>A bigger canon <em>cost more than it saved.</em></h2>
      <p class="prose article-lede">
        An earlier Canon asked for much more, and one adopter followed it to
        the letter for 30 days: 640 commits, 384 canon files, 200,000 words,
        271 decision records. Every rule below sounded like diligence. Each
        one is gone.
      </p>

      <table class="gate-table">
        <caption class="sr-only">
          Rules of the earlier Canon, what each produced in one adopter over
          30 days, and what replaced it.
        </caption>
        <thead>
          <tr>
            <th scope="col">The old rule</th>
            <th scope="col">What it produced</th>
            <th scope="col">Now</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Stamp every page</th>
            <td>
              Canon touched in 488 of 639 commits; about half of all canon
              file touches were <code>verified:</code> bumps.
            </td>
            <td>No front matter, no stamps, no review dates.</td>
          </tr>
          <tr>
            <th scope="row">Read the manifest first</th>
            <td>About 23k tokens read before any code, every session.</td>
            <td>Nothing up front. A task that needs a note reads that note.</td>
          </tr>
          <tr>
            <th scope="row">Immutable decisions</th>
            <td>
              271 records; an approval record's &ldquo;any other path voids
              this approval&rdquo; reverted finished work 18 minutes after it
              landed.
            </td>
            <td>
              No records. The reason goes in the commit; the owner's current
              word outranks every note.
            </td>
          </tr>
          <tr>
            <th scope="row">Record the complete contract</th>
            <td>Specs that copied the code and drifted to wrong production defaults.</td>
            <td>Limits and defaults live in code and tests only.</td>
          </tr>
        </tbody>
      </table>

      <p class="lifecycle-close">
        That canon is now four notes. Nothing enforced the old rules; agents
        followed them anyway. So the new ones are written to be followed too:
        small by rule, at the moment of writing.
      </p>
    </section>

    <section id="record" class="article shell" aria-label="What the record holds">
      <div class="article-rule"><span><b>§ III</b> — The record</span></div>

      <div class="split">
        <div class="split-lead">
          <h2>A note earns its place — <em>or it goes.</em></h2>
          <p class="prose">
            One flat directory: <code>canon/</code>, at most twelve notes of
            about a thousand words, unless the owner sets other numbers. Each
            is plain Markdown, named for the question it answers. At the
            limit, a note is added only by removing or merging one; a long
            note is never split to fit.
          </p>
          <p class="prose">
            Everything else has a better home. How to work here goes in the
            instruction file, in the owner's words. Behavior and limits go in
            code and a test. Why a change was made goes in the commit body;
            how to recover, in the runbook beside the tool. <a
            class="inline-link" href="/how-it-works">A record that owns too
            much governs nothing</a>.
          </p>
        </div>

        <div class="anatomy" role="list">
          {anatomy.map(({ name, copy }) => (
            <article role="listitem">
              <h3>{name}</h3>
              <p>{copy}</p>
            </article>
          ))}
        </div>
      </div>

      <RoutingPlate />

      <div class="binds">
        <div>
          <h3>It binds by being loaded, not believed.</h3>
          <p>
            The block ships as the AGENTS.md or CLAUDE.md agents already
            read, and it is the only up-front context. Authority is plain:
            for what should be true, the owner's current instruction, then
            the block, then the notes; for what is true now, code and tests.
          </p>
        </div>
        <div>
          <h3>Untouched is the usual verdict.</h3>
          <p>
            Most changes are moves, renames, refactors and new instances of a
            pattern. They make no note false, so they leave canon/ alone.
            That is not neglect; that is the record staying true.
          </p>
        </div>
      </div>
    </section>

    <section id="trigger" class="article shell" aria-label="The write trigger">
      <div class="article-rule"><span><b>§ IV</b> — The trigger</span></div>

      <h2>Write when something <em>became false.</em></h2>
      <p class="prose article-lede">
        No report line, no classification ceremony. The block says exactly
        when an agent must, may and must not touch the record.
      </p>

      <table class="gate-table">
        <caption class="sr-only">
          When an agent must, may, and must not edit Canon.
        </caption>
        <thead>
          <tr>
            <th scope="col">Verdict</th>
            <th scope="col">When</th>
            <th scope="col">The record</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Must</th>
            <td>
              The change makes a Canon sentence false, or changes a
              guarantee, contract or accepted gap a note states.
            </td>
            <td>Fixed or deleted in the same change, even unprompted.</td>
          </tr>
          <tr>
            <th scope="row">May</th>
            <td>
              A cross-owner guarantee had to be reconstructed from several
              files, or an attempt was measured and dropped.
            </td>
            <td>One clause added to an existing note. Or delete text that is false or restates code.</td>
          </tr>
          <tr>
            <th scope="row">Must not</th>
            <td>
              Nearby code moved. A decision was made. The agent has a plan,
              an approval, a handover, a preference.
            </td>
            <td>
              Untouched. No new note without the owner's approval; progress
              and handovers go to scratch.
            </td>
          </tr>
        </tbody>
      </table>

      <p class="lifecycle-close">
        Nothing in Canon is immutable. A reversal edits the clause in place,
        and git keeps the old one.
      </p>
    </section>

    <section id="discipline" class="article shell" aria-label="The discipline under conflict and absence">
      <div class="article-rule"><span><b>§ V</b> — The discipline</span></div>

      <div class="interview-grid">
        <div class="split-lead">
          <h2>The owner outranks <em>the record.</em></h2>
          <p class="prose">
            When a note disagrees with what the owner asks now, the agent
            says so once, does what was asked, and fixes or deletes the note
            in the same change. A note cannot grant permission, veto the
            owner, or be cited to delay them. Only the owner's words make a
            rule; an agent never records its own choices as must or never.
          </p>
          <p class="prose">
            And when the record is silent, silence is an answer. Never guess
            absent policy, limits or rationale: stop the policy-dependent
            work and report the exact gap. A guessed limit becomes
            load-bearing the moment it is written down.
          </p>

          <blockquote class="creed">
            <p>
              &ldquo;Urgency waives neither tests nor these rules.&rdquo;
            </p>
            <cite>— the shipped block</cite>
          </blockquote>
        </div>

        <figure class="transcript" aria-label="Two impulses, corrected by the rules">
          <div class="turn">
            <span class="who">impulse</span>
            <p class="said">
              The exports note says archived rows must never appear, and any
              change voids its approval. I'll refuse the owner's request.
            </p>
          </div>
          <div class="turn you">
            <span class="who">rule</span>
            <p class="said">
              Nothing in Canon outranks what the owner says now. Say once that
              the note disagrees, do what was asked, fix the note.
            </p>
          </div>
          <div class="turn">
            <span class="who">impulse</span>
            <p class="said">
              The export job needs a retry ceiling and nothing says what it
              is. Three feels right; I'll write it into a note.
            </p>
          </div>
          <div class="turn you">
            <span class="who">rule</span>
            <p class="said">
              Absent policy is a gap, not an invitation. Stop the dependent
              work, report the gap, record no guess.
            </p>
          </div>

          <div class="drafted">
            <span class="who">Filed — end-of-session report</span>
            <p>
              <strong>Done:</strong> archived rows export with a flag, as
              asked; the exports note now says only what is still true.
              <strong>Gap:</strong> no retry policy exists for exports; none
              was guessed.
            </p>
            <div class="gate-chips">
              <span><b>✓</b> owner's word followed</span>
              <span><b>✓</b> note fixed</span>
              <span><b>✓</b> nothing invented</span>
            </div>
          </div>
        </figure>
      </div>
    </section>

    <section id="evidence" class="article shell" aria-label="Evaluation evidence">
      <div class="article-rule"><span><b>§ VI</b> — The evidence</span></div>

      <div class="evidence-grid">
        <div class="split-lead">
          <h2>Measured in the field, <em>tested in the lab.</em></h2>
          <p class="prose">
            The rules changed because of the field numbers in § II, not
            because of an eval win. The earlier core passed this repository's
            own lab, which rewarded manifest routing, decision records and
            immutable predecessors — the behaviors that cost the adopter
            most. Its scores stay in the ledger, marked as measuring the
            retired core.
          </p>
          <p class="prose">
            The lab now tests the current rules: fifteen scenarios that drop
            real coding agents into seeded repositories. Every run gets two
            scores, mechanical and judged, reported separately; hidden
            holdout tests run in disposable copies. The new set has not yet
            been run against live models, so no score is claimed.
          </p>
          <p class="evidence-notes">
            Rejections are recorded, not buried, and the whole harness is
            public in the repository.
          </p>
        </div>

        <figure class="term lab" aria-label="Evaluation scenarios">
          <figcaption class="term-bar">
            <span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span>evals/scenarios</span>
          </figcaption>
          <div class="term-body" tabindex="0">
            {scenarios.map(([id, gloss]) => (
              <div class="scenario">
                <span class="dim">{id}</span>
                <span>{gloss}</span>
              </div>
            ))}
            <div class="lab-axes">
              <span class="dim">scores:</span> mechanical + judged · reported separately<br />
              <span class="dim">holdouts:</span> hidden tests <span class="dim">·</span> run in disposable copies<br />
              <span class="dim">status:</span> <span class="pass">built and smoke-tested</span> <span class="dim">· live baseline pending</span>
            </div>
          </div>
        </figure>
      </div>
    </section>

    <section id="adopt" class="article shell" aria-label="Install Project Canon">
      <div class="article-rule"><span><b>§ VII</b> — Adoption</span></div>

      <div class="adopt-lead">
        <h2>One block. <em>It starts empty.</em></h2>
        <p class="prose">
          Canon ships as one generated block for the instruction file your
          agents already load — no framework, no dependency, no hook, no CI
          step. The whole errand is one copy and a bootstrap session: do it
          by hand, or hand it to an agent you already run. The record starts
          empty on purpose, and an empty Canon is healthy.
        </p>
      </div>

      <div class="setup-grid">
        <figure class="term setup-term" aria-label="Setup by hand">
          <figcaption class="term-bar">
            <span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span>setup — by hand</span>
          </figcaption>
          <div class="term-body" tabindex="0">
            <span class="dim">$</span> CANON="$(mktemp -d)" &amp;&amp; git clone --depth 1 https://github.com/stefan-vatov/canon "$CANON"<br />
            <span class="dim">$</span> test -e AGENTS.md || cp "$CANON/dist/AGENTS.md" AGENTS.md<br />
            <span class="dim">$</span> test -e CLAUDE.md || echo '@AGENTS.md' &gt; CLAUDE.md<br />
            <span class="dim">&nbsp;&nbsp;# a file already there? merge the block instead (INSTALL.md)</span><br />
            <span class="dim">&nbsp;&nbsp;# your own rules go above or below the BEGIN/END markers</span><br />
            <span class="dim">$</span> rm -rf "$CANON"; claude<br />
            <span class="pass">&gt;</span> set up Project Canon in this repository; write no notes
          </div>
        </figure>

        <figure class="prompt-card" aria-label="Setup by agent">
          <figcaption class="prompt-bar">
            <span>setup — by agent</span>
            <button class="copy-btn" type="button" data-copy="agent-setup-prompt">copy</button>
          </figcaption>
          <p class="prompt-text" id="agent-setup-prompt">
            Install Project Canon from https://github.com/stefan-vatov/canon:
            shallow-clone it into a fresh temporary directory, stopping if the
            clone fails. If AGENTS.md does not exist, copy dist/AGENTS.md there;
            if it does, merge the marked block in with INSTALL.md's managed
            merge and keep everything outside the markers. Never overwrite an
            existing CLAUDE.md; if Claude Code works here, make CLAUDE.md
            import AGENTS.md with an @AGENTS.md line rather than a second copy.
            Then set up the repository Canon: create canon/, add canon/scratch/
            to the repository-root .gitignore, and write no notes. Remove the
            clone and report what you changed.
          </p>
          <p class="prompt-note">
            Paste into any agent session in your repo. Installation can be
            delegated; what earns a note is the owner's call.
          </p>
        </figure>
      </div>

      <ol class="ratify-steps">
        <li>
          <h3>Install the block</h3>
          <p>
            dist/AGENTS.md for Codex, Pi and anything else that reads it; a
            CLAUDE.md that imports it for Claude Code, so there is one copy
            of the rules. It is one marked block: your own rules go above or
            below it, and upgrades replace only the block.
          </p>
        </li>
        <li>
          <h3>Bootstrap empty</h3>
          <p>
            A fresh session creates canon/, ignores canon/scratch/, and writes
            nothing else: no manifest, no standards page, no skeleton. A note
            arrives when a task needs one and the owner agrees.
          </p>
        </li>
        <li>
          <h3>Migrate once, if you must</h3>
          <p>
            A canon built under the old rules — records, manifest, stamps,
            specs — is slimmed once with the compact-canon skill, then the
            skill is removed. Nothing runs afterwards.
          </p>
        </li>
      </ol>

      <p class="mono-note adopt-note">
        the migration skill: <b>compact-canon</b> — tag first, instructions
        first, runbooks beside their tools, citations repointed, decision
        records deleted after their live rules move, specs that copy code
        deleted, review against the tag. a dry run changes nothing.
      </p>
    </section>

    <aside class="meta-strip" aria-label="Field evidence note">
      <div class="shell">
        <ArchMark class="device-inline" />
        <p>
          <strong>Smaller because the field said so.</strong> One adopter's
          canon grew to 384 files and 271 decision records in 30 days, and
          was touched in 488 of 639 commits. After one migration it is four
          notes. The
          <a
            class="inline-link"
            href="https://github.com/stefan-vatov/canon/blob/main/evals/BASELINES.md"
            target="_blank"
            rel="noopener"
            aria-label="Read the evaluation baselines ledger (opens in a new tab)"
          >evidence ledger</a>
          is public in the repo, retired scores included.
        </p>
      </div>
    </aside>

    <CompanionPlate />

    <SiteFooter />
  </main>

  <script>
    const revertTimers = new WeakMap<HTMLButtonElement, number>();

    const swapLabel = (btn: HTMLButtonElement, text: string) => {
      btn.classList.add("is-swapping");
      setTimeout(() => {
        btn.textContent = text;
        btn.classList.remove("is-swapping");
      }, 130);
    };

    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const source = document.getElementById(btn.dataset.copy ?? "");
        if (!source) return;
        let label = "copied";
        try {
          await navigator.clipboard.writeText(source.innerText.trim());
        } catch {
          const range = document.createRange();
          range.selectNodeContents(source);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
          if (document.execCommand("copy")) {
            selection?.removeAllRanges();
          } else {
            label = "press ⌘C";
          }
        }
        swapLabel(btn, label);
        clearTimeout(revertTimers.get(btn));
        revertTimers.set(
          btn,
          window.setTimeout(() => swapLabel(btn, "copy"), 1900),
        );
      });
    });
  </script>
</BaseLayout>
