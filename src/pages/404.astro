---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "404 — no such page | Project Canon";
const pageDescription =
  "No page exists at this address. Rather than guess what you meant, the gap is hereby reported.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <SiteHeader root="/" />
  <main id="main">
    <section class="notfound shell">
      <span class="mono-label">A gap, reported</span>
      <h1>Nothing lives here.</h1>
      <p class="prose">
        No page exists at this address: it never existed, or it moved. Per
        the rules, a gap is surfaced, never guessed over. Consider it
        reported.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/">Back to the overview</a>
        <a class="btn btn-ghost" href="/how-it-works">Why so little</a>
      </div>
    </section>
    <SiteFooter />
  </main>
</BaseLayout>
