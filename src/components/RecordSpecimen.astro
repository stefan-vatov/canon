---
type Seg = { t: string; c?: "dim" | "pass" | "flag" };
type Meta = { k: string; v: string; normative?: boolean }[];
type Section = {
  id: string;
  tab: string;
  file: string;
  meta?: Meta;
  metaNote?: string;
  docLabel: string;
  index?: { marker: string; text: string }[];
  featuredLabel?: string;
  title: string;
  body: string[];
  rejects?: string;
  barTitle: string;
  trace: Seg[][];
};

const d = (t: string): Seg => ({ t, c: "dim" });
const p = (t: string): Seg => ({ t, c: "pass" });
const f = (t: string): Seg => ({ t, c: "flag" });
const n = (t: string): Seg => ({ t });

const sections: Section[] = [
  {
    id: "note",
    tab: "A note",
    file: "canon/payment-retries.md",
    docLabel: "A guarantee spanning several owners",
    title: "A retried charge never bills twice.",
    body: [
      "Checkout, the billing worker and the bank adapter all rely on the client's idempotency key, so no single module can hold this rule. A replay returns the first result; the reason is a customer double-billed in an outage (owner). Enforced by the charge-replay test.",
    ],
    rejects:
      "No front matter, no file list, no limits copied from code. Current fact, its reason in a clause, and the test that enforces it.",
    barTitle: "a task that needs it",
    trace: [
      [d(">"), n(" task: add a refund endpoint")],
      [d("$"), n(" ls canon/")],
      [d("read:"), n(" payment-retries.md "), d("· its name matches the task")],
      [d("skip:"), n(" 6 other notes "), d("· unread by design")],
      [p("→"), n(" one note read; a code-only task reads none")],
    ],
  },
  {
    id: "homes",
    tab: "Where it goes",
    file: "most knowledge never enters canon/",
    docLabel: "First home that fits",
    index: [
      { marker: "—", text: "how to work here → the instruction file, in the owner's words" },
      { marker: "—", text: "behavior, limits, error cases → code and a test" },
      { marker: "—", text: "why this code is odd → a comment at that code" },
      { marker: "—", text: "why a change was made → the commit body" },
      { marker: "—", text: "how to deploy or recover → the runbook beside the tool" },
    ],
    featuredLabel: "The rule",
    title: "Decisions get no records.",
    body: [
      "When the owner decides, the agent implements it and puts the reason and the rejected alternative in the commit body. Only if the decision constrains future work in a way code cannot show does one clause go into the document it constrains.",
    ],
    barTitle: "an owner decision lands",
    trace: [
      [d(">"), n(' owner: "report times in UTC; local time was rejected"')],
      [d("code:"), n(" format_timestamp + its test")],
      [d("commit:"), n(" the reason and the rejected option")],
      [d("record:"), n(" none "), p("· no decisions/ directory")],
      [p("→"), n(" a later reversal edits the clause in place")],
    ],
  },
  {
    id: "owner",
    tab: "Owner wins",
    file: "canon/exports.md",
    docLabel: "A note that disagrees",
    title: "\u201cArchived rows must never be exported.\u201d",
    body: [
      "The note goes on: approved in March, and any change voids that approval and must be reverted. Wording like this once reverted a finished piece of work 18 minutes after it landed. Under the current rules it binds nothing: a note cannot grant permission or outrank the owner.",
    ],
    rejects:
      "Only the owner's words make a rule. A note records guarantees and owner constraints with their reasons.",
    barTitle: "the owner's current word governs",
    trace: [
      [d(">"), n(" owner: export archived rows, flagged for finance")],
      [d("note:"), n(' "must never appear" '), f("disagrees")],
      [d("say:"), n(" once, that the exports note disagrees")],
      [d("do:"), n(" what was asked, and fix the note in the same change")],
      [p("→"), n(" the note follows the owner, never the reverse")],
    ],
  },
  {
    id: "false",
    tab: "False sentence",
    file: "canon/sessions.md",
    docLabel: "The write trigger",
    title: "Fix what your change made false.",
    body: [
      "A change that makes a Canon sentence false fixes or deletes it in the same change, even when the task never mentioned documentation. Moves, renames, refactors and repeats of a pattern oblige nothing, so most changes leave canon/ untouched.",
    ],
    barTitle: "one sentence goes stale",
    trace: [
      [d(">"), n(" task: make the session timeout per tenant")],
      [d("note:"), n(' "every session expires after exactly 30 minutes" '), f("now false")],
      [d("edit:"), n(" that sentence, in the same change")],
      [d("keep:"), n(" the sweeper guarantee "), p("· still true")],
      [p("→"), n(" the new range lives in code and tests, not the note")],
    ],
  },
  {
    id: "scratch",
    tab: "Scratch",
    file: "canon/scratch/handover.md",
    metaNote: "git-ignored · never read unless asked · never cited",
    docLabel: "Outside the record",
    title: "Where session notes go to be forgotten.",
    body: [
      "Handovers, progress, half-thoughts and approvals belong here and nowhere else. Scratch is git-ignored, never read at session start, and never cited, so nothing written in a hurry turns into a rule.",
    ],
    rejects: "No changelog, progress log or handover anywhere but scratch.",
    barTitle: "the boundary holds",
    trace: [
      [d(">"), n(' scratch note: "ALWAYS run the whole suite twice"')],
      [d("read:"), n(" skipped "), d("· scratch is unread by default")],
      [d("rank:"), n(" no authority "), d("· an agent's note is not a rule")],
      [p("→"), n(" a note cannot become a law by being found")],
    ],
  },
];
---

<section
  id="specimen"
  class="article shell"
  aria-label="Exhibit A — the record at work"
>
  <div class="article-rule"><span><b>Exhibit A</b> — the record, live</span></div>

  <h2>This is what a canon <em>is.</em></h2>
  <p class="prose specimen-lead">
    Before the argument, the artifact. A canon is a handful of flat notes
    and one ignored scratch directory, governed by one block of rules in the
    instruction file (<a
      class="inline-link"
      href="https://github.com/stefan-vatov/canon"
      target="_blank"
      rel="noopener"
      aria-label="The Canon rules on GitHub (opens in a new tab)"
    >the rules are public</a>). Most of what agents learn never enters it.
    Beside each example, the trace shows the rule that keeps it small.
  </p>

  <div class="specimen">
    <div class="specimen-tabs" role="tablist" aria-label="How the record works">
      {sections.map((s, i) => (
        <button
          class="specimen-tab"
          type="button"
          role="tab"
          id={`specimen-tab-${s.id}`}
          aria-controls={`specimen-pane-${s.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
        >
          {s.tab}
        </button>
      ))}
    </div>

    <div class="specimen-stage">
      {sections.map((s, i) => (
        <div
          class={`specimen-pane${i === 0 ? " is-active" : ""}`}
          role="tabpanel"
          id={`specimen-pane-${s.id}`}
          aria-labelledby={`specimen-tab-${s.id}`}
          inert={i !== 0}
        >
          <figure class="doc-card specimen-doc" data-file={s.file}>
            {s.meta && (
              <div class="doc-meta" aria-label="File details">
                {s.meta.map((row, j) => (
                  <>
                    <span class="k">{row.k}:</span>{" "}
                    <span class={`v${row.normative ? " normative" : ""}`}>{row.v}</span>
                    {j < (s.meta?.length ?? 0) - 1 && <br />}
                  </>
                ))}
              </div>
            )}
            {s.metaNote && <div class="doc-meta">{s.metaNote}</div>}
            <span class="doc-label">{s.docLabel}</span>
            {s.index && (
              <ul class="doc-index">
                {s.index.map((item) => (
                  <li>
                    <span class="no" aria-hidden="true">{item.marker}</span>
                    {item.text}
                  </li>
                ))}
              </ul>
            )}
            {s.index && <div class="doc-divide" role="presentation"></div>}
            {s.featuredLabel && <span class="doc-label">{s.featuredLabel}</span>}
            <p class="doc-title">{s.title}</p>
            {s.body.map((para) => <p>{para}</p>)}
            {s.rejects && <p class="doc-rejects">{s.rejects}</p>}
          </figure>
          <figure class="term specimen-term">
            <figcaption class="term-bar">
              <span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span>{s.barTitle}</span>
            </figcaption>
            <div class="term-body" tabindex="0">
              {s.trace.map((line) => (
                <p>
                  {line.map((seg) =>
                    seg.c ? <span class={seg.c}>{seg.t}</span> : seg.t,
                  )}
                </p>
              ))}
            </div>
          </figure>
        </div>
      ))}
    </div>
  </div>

  <figure class="wiring">
    <figcaption class="mono-note">
      shipped as one block in <b>AGENTS.md</b> (or <b>CLAUDE.md</b>) — the file every session already loads
    </figcaption>
    <pre class="wiring-sheet" tabindex="0" aria-label="Excerpt of the generated Canon block">Project Canon is a handful of notes in `canon/` holding what code,
tests and git cannot tell you. This file is the only up-front
context: read nothing in `canon/` at session start.

Authority: for what should be true, the owner's current instruction,
then this file, then Canon notes. For what is true now, code and
tests. Nothing in Canon outranks what the owner says now.

Decisions get no records. No `decisions/` directory, decision log,
register or ADR.
…</pre>
  </figure>
</section>

<script>
  const tablist = document.querySelector<HTMLElement>(".specimen-tabs");
  if (tablist) {
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>(".specimen-tab")];
    const panes = tabs.map((tab) =>
      document.getElementById(tab.getAttribute("aria-controls") ?? ""),
    );

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        panes[i]?.toggleAttribute("inert", !on);
        panes[i]?.classList.toggle("is-active", on);
      });
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i));
    });

    tablist.addEventListener("keydown", (event) => {
      const current = tabs.findIndex(
        (tab) => tab.getAttribute("aria-selected") === "true",
      );
      let next = -1;
      if (event.key === "ArrowRight") next = (current + 1) % tabs.length;
      else if (event.key === "ArrowLeft")
        next = (current - 1 + tabs.length) % tabs.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = tabs.length - 1;
      if (next >= 0) {
        event.preventDefault();
        select(next, true);
      }
    });
  }
</script>
