---
interface Props {
  /** Prefix for section anchors — "" on the index page, "/" elsewhere. */
  root?: string;
}

const { root = "" } = Astro.props;
const onEssay = Astro.url.pathname.replace(/\/$/, "") === "/how-it-works";
---

<header class="site-header" aria-label="Primary">
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="shell">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">
        {/* the arch stays ivory in both editions — the chip is wax-red either way */}
        <svg viewBox="4 8 92 88" width="18" height="17.2">
          <path fill="#fbf9f3" d="M 10 90 L 10 82 L 14 82 L 14 52 A 36 36 0 0 1 86 52 L 86 82 L 90 82 L 90 90 L 62 90 L 62 82 L 66 82 L 66 52 A 16 16 0 0 0 34 52 L 34 82 L 38 82 L 38 90 Z"/>
          <line x1="39.3" y1="14.5" x2="46.4" y2="39.5" stroke="var(--seal)" stroke-width="3.2"/>
          <line x1="60.7" y1="14.5" x2="53.6" y2="39.5" stroke="var(--seal)" stroke-width="3.2"/>
        </svg>
      </span>
      <span class="brand-name">Project Canon</span>
    </a>
    <nav class="site-nav" aria-label="Site">
      <a href={`${root}#churn`}>The churn</a>
      <a href={`${root}#record`}>The record</a>
      <a href={`${root}#gate`}>The gate</a>
      <a href={`${root}#evidence`}>Evidence</a>
      <a href="/how-it-works" aria-current={onEssay ? "page" : undefined}>
        Why invariants
      </a>
      <a
        href="https://github.com/stefan-vatov/canon"
        target="_blank"
        rel="noopener"
        aria-label="GitHub repository (opens in a new tab)"
      >
        GitHub <span aria-hidden="true">↗</span>
      </a>
      <button class="theme-cycle" type="button" data-theme-cycle hidden>
        <span class="theme-cycle-state">Auto</span>
      </button>
      <a class="nav-cta" href={`${root}#adopt`}>Install</a>
    </nav>
  </div>
</header>

<script is:inline>
  // The theme cycle: Auto (OS preference) -> Day -> Night. The stored
  // choice is read again here so the label matches whatever the head
  // script stamped before paint. The label swaps with the same blur the
  // copy button uses; the page itself turns instantly, like a page.
  (() => {
    const btn = document.querySelector("[data-theme-cycle]");
    if (!btn) return;
    const state = btn.querySelector(".theme-cycle-state");
    const order = ["auto", "light", "dark"];
    const names = { auto: "Auto", light: "Day", dark: "Night" };
    const osDark = matchMedia("(prefers-color-scheme: dark)");

    const read = () => {
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") return t;
      } catch {}
      return "auto";
    };

    const apply = (mode) => {
      const root = document.documentElement;
      if (mode === "auto") delete root.dataset.theme;
      else root.dataset.theme = mode;
      const dark = mode === "dark" || (mode === "auto" && osDark.matches);
      for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
        meta.setAttribute("content", dark ? "#161310" : "#f4f1e9");
      }
      const next = names[order[(order.indexOf(mode) + 1) % order.length]];
      btn.setAttribute(
        "aria-label",
        `Color theme: ${names[mode]}. Activate for ${next.toLowerCase()}.`
      );
    };

    let mode = read();
    state.textContent = names[mode];
    apply(mode);
    btn.hidden = false;

    btn.addEventListener("click", () => {
      mode = order[(order.indexOf(mode) + 1) % order.length];
      try {
        if (mode === "auto") localStorage.removeItem("theme");
        else localStorage.setItem("theme", mode);
      } catch {}
      apply(mode);
      btn.classList.add("is-swapping");
      setTimeout(() => {
        state.textContent = names[mode];
        btn.classList.remove("is-swapping");
      }, 150);
    });

    // in Auto, the browser chrome color must track a live OS change
    osDark.addEventListener("change", () => {
      if (mode === "auto") apply("auto");
    });
  })();
</script>
