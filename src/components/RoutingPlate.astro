---
// Plate I — the routing chart, mounted like a plate from an atlas.
// There is no manifest: a task that needs Canon lists canon/ and reads
// the note whose name matches. Picking a task lights only that note. A
// rename or a code-only feature lights nothing, not even the listing.

type Node = {
  id: string;
  label: string;
  x: number;
  y: number;
  w: number;
  when?: string;
  lit: string[];
};

const HUB = { x: 54, y: 170, w: 132, h: 30, cx: 120, cy: 185 };

const nodes: Node[] = [
  {
    id: "payments",
    label: "payment-retries.md",
    x: 430,
    y: 46,
    w: 236,
    when: "guarantee across owners",
    lit: ["t1"],
  },
  {
    id: "restore",
    label: "restore-gaps.md",
    x: 430,
    y: 108,
    w: 236,
    when: "accepted gap, with its reason",
    lit: [],
  },
  {
    id: "latency",
    label: "latency-lessons.md",
    x: 430,
    y: 170,
    w: 236,
    when: "measured dead ends",
    lit: ["t3"],
  },
  {
    id: "sync",
    label: "offline-sync.md",
    x: 430,
    y: 232,
    w: 236,
    when: "guarantee across owners",
    lit: [],
  },
  {
    id: "plan",
    label: "plan-search.md",
    x: 430,
    y: 294,
    w: 236,
    when: "approved plan, deleted once built",
    lit: [],
  },
];

const edge = (node: Node) => {
  const x1 = HUB.x + HUB.w;
  const y1 = HUB.cy;
  const x2 = node.x;
  const y2 = node.y + 15;
  const mx = (x1 + x2) / 2;
  return `M${x1} ${y1} C${mx} ${y1}, ${mx} ${y2}, ${x2} ${y2}`;
};

const tasks = [
  { id: "t1", label: "fix refund retries" },
  { id: "t2", label: "rename a helper" },
  { id: "t3", label: "cache session lookups" },
];

const verdicts = [
  { id: "t1", parts: ["1 note read", " — its name matches the task; the rest stay unread"] },
  { id: "t2", parts: ["nothing read", " — a rename makes no sentence false · canon untouched"] },
  { id: "t3", parts: ["1 note read", " — the cache was measured once and dropped"] },
];
---

<figure class="tree-exhibit" aria-label="Plate I — the routing chart">
  <div class="plate">
    <div class="plate-bar">
      <span class="plate-label">Plate I — the routing chart</span>
      <span class="term-ab" role="group" aria-label="Pick a task">
        <span>task:</span>
        {tasks.map((t, i) => (
          <button
            class="term-ab-btn"
            type="button"
            data-task={t.id}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            {t.label}
          </button>
        ))}
      </span>
    </div>
    <div class="tree-body">
      <svg
        class="route-svg"
        viewBox="0 0 760 400"
        role="img"
        aria-label="A chart of a repository's canon directory. A hub node, the listing of canon/, connects by curved lines to five flat notes, each annotated with the kind of knowledge it holds. A scratch node sits apart behind a dashed border, connected to nothing. Depending on the chosen task, either one note and the listing light up, or nothing does."
      >
        {nodes.map((node) => (
          <path
            class="route-edge"
            data-lit={node.lit.join(" ")}
            d={edge(node)}
          ></path>
        ))}

        <g class="route-node hub">
          <rect x={HUB.x} y={HUB.y} width={HUB.w} height={HUB.h} rx="4"></rect>
          <text x={HUB.cx} y={HUB.cy + 4} text-anchor="middle">ls canon/</text>
        </g>

        {nodes.map((node) => (
          <>
            <g class="route-node" data-lit={node.lit.join(" ")}>
              <rect x={node.x} y={node.y} width={node.w} height="30" rx="4"></rect>
              <text x={node.x + node.w / 2} y={node.y + 19} text-anchor="middle">
                {node.label}
              </text>
            </g>
            <text
              class="route-when"
              data-lit={node.lit.join(" ")}
              x={node.x - 12}
              y={node.y + 8}
              text-anchor="end"
            >
              {node.when}
            </text>
          </>
        ))}

        <g class="route-node scratch">
          <rect x={HUB.x} y="330" width={HUB.w} height="30" rx="4"></rect>
          <text x={HUB.cx} y="349" text-anchor="middle">scratch/</text>
        </g>
        <text class="route-when" x={HUB.x + HUB.w + 14} y="349">
          never read unless asked · never cited
        </text>
      </svg>
      <p class="route-verdict" aria-live="polite">
        {verdicts.map((v, i) => (
          <span data-task={v.id} class={i === 0 ? "is-lit" : ""}>
            <b>{v.parts[0]}</b>{v.parts[1]}
          </span>
        ))}
      </p>
    </div>
  </div>
  <figcaption class="plate-caption">
    No manifest, no session-start read. A task that touches a note's
    subject lists the directory and reads that one note; everything else
    stays unread, and a change that is only geography reads nothing at all.
  </figcaption>
</figure>

<script>
  const plate = document.querySelector<HTMLElement>(".tree-exhibit");
  if (plate) {
    const buttons = [...plate.querySelectorAll<HTMLButtonElement>(".term-ab-btn")];
    const litable = [...plate.querySelectorAll<Element>("[data-lit]")];
    const verdicts = [...plate.querySelectorAll<Element>(".route-verdict [data-task]")];

    const select = (task: string) => {
      buttons.forEach((btn) =>
        btn.setAttribute("aria-pressed", String(btn.dataset.task === task)),
      );
      litable.forEach((el) => {
        const lit = (el.getAttribute("data-lit") ?? "").split(" ");
        el.classList.toggle("is-lit", lit.includes(task));
      });
      // the listing lights only when a note is read: a task that needs no
      // Canon does not even list the directory
      const hubLit = litable.some((el) => el.classList.contains("is-lit"));
      plate.querySelector(".route-node.hub")?.classList.toggle("is-lit", hubLit);
      verdicts.forEach((el) =>
        el.classList.toggle("is-lit", el.getAttribute("data-task") === task),
      );
    };

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => select(btn.dataset.task ?? ""));
    });

    select("t1");
  }
</script>
